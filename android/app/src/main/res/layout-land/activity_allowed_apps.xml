<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/allowed_apps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unbound_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <EditText
            android:id="@+id/allowed_apps_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/allowed_apps_search_field"
            android:hint="@string/allowed_apps_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:minHeight="48dp"
            android:singleLine="true"
            android:textColor="@color/unbound_ink"
            android:textColorHint="@color/unbound_muted" />

        <TextView
            android:id="@+id/allowed_apps_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/unbound_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/allowed_apps_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp" />

        <ProgressBar
            android:id="@+id/allowed_apps_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/unbound_ink" />

        <TextView
            android:id="@+id/allowed_apps_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/allowed_apps_empty"
            android:textColor="@color/unbound_muted"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/allowed_apps_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/allowed_apps_cancel"
            android:textAllCaps="false"
            android:textColor="@color/unbound_ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/allowed_apps_clear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/allowed_apps_clear"
            android:textAllCaps="false"
            android:textColor="@color/unbound_ink"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/allowed_apps_save"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/allowed_apps_save_background"
            android:stateListAnimator="@null"
            android:text="@string/allowed_apps_save"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
